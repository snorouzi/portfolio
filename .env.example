# Vite environment variables for the portfolio application.
#
# Variables prefixed with VITE_ are exposed to client-side code and are
# bundled into the application bundle. They are publicly readable, so never
# store API secrets, database credentials, private keys, or access tokens here.
#
# After changing these values, restart the development server (npm run dev)
# for the changes to take effect.

# Human-readable application name used in the page title and metadata.
VITE_APP_NAME=Personal Portfolio

# Canonical URL of the running application (used for metadata and links).
VITE_APP_URL=http://localhost:3000

# Port for the Vite development and preview servers (default: 3000).
VITE_PORT=3000
